{
  "name": "@dispatch/plugin-claude",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Built-in Dispatch plugin: runs chats on Anthropic's Claude Code through the Claude Agent SDK.",
  "exports": {
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "import": "./server/descriptor.js"
    },
    "./harness": {
      "types": "./src/index.ts",
      "import": "./server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.222",
    "@anthropic-ai/sdk": "^0.109.1",
    "@dispatch/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
