{
  "name": "@dispatch/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Electron shell for Dispatch — owns the server process and every child it spawns.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/generate-icon.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "node scripts/generate-icon.mjs",
    "start": "electron .",
    "dev": "pnpm build && electron ."
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "electron": "^33.4.11",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  }
}
